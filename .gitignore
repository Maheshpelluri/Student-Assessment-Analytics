# Ignore raw datasets and exported tables
*.csv
*.xls
*.xlsx
*.xlsm
*.xlsb
data/
raw_data/
datasets/

# Power BI files and temporary artifacts (exclude .pbix by default to avoid leaking data)
*.pbix
*.pbit

# Power BI cache/temp
*.bin
*.cache

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
*.code-workspace

# Temporary Office files
~$*

# Node / Python / general
node_modules/
__pycache__/
